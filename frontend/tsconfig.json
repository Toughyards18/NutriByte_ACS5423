
{
  "compilerOptions": {
    "baseUrl": "src",
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "target": "es2020",   
    "lib": [
      "dom",
      "dom.iterable",
      "esnext",
      "es2020"
    ],
    "module": "esnext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "allowJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "strict": true
  }
}
